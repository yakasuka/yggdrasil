{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yggdrasil-subscriptions",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "",
    "TCP_PROBE_ENABLED": "true",
    "TEMPLATE_URL": "bundled",
  },
  "kv_namespaces": [
    { "binding": "SUBSCRIPTIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" },
  ],
  "ratelimits": [
    {
      "name": "INSPECT_LIMITER",
      "namespace_id": "271829",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "PROBE_LIMITER",
      "namespace_id": "271830",
      "simple": { "limit": 240, "period": 60 },
    },
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "271828",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
