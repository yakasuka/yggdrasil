[Unit]
Description=Yggdrasil self-hosted config service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yggdrasil
Group=yggdrasil
WorkingDirectory=/opt/yggdrasil/config-builder
EnvironmentFile=/opt/yggdrasil/config-builder/server/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yggdrasil/config-builder/server/data

[Install]
WantedBy=multi-user.target
