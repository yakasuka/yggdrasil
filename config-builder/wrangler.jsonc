{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yggdrasil-configurator",
  "pages_build_output_dir": "./worker/gateway/dist",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ALLOWED_ORIGINS": "",
  },
  "kv_namespaces": [
    { "binding": "SUBSCRIPTIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" },
  ],
}
