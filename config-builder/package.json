{
  "name": "yggdrasil-config-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog": "node scripts/generate-catalog.mjs",
    "build": "npm run catalog && node scripts/build.mjs && npm run service:build",
    "test": "node --test tests/*.test.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:whoami": "wrangler whoami",
    "service:build": "node scripts/build-gateway.mjs",
    "service:dev": "npm run service:build && wrangler pages dev --port 8788",
    "service:deploy": "npm run service:build && wrangler pages deploy"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "http-parser-js": "^0.5.10",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.0.0"
  }
}
