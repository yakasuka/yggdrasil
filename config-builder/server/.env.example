# Copy to server/.env. Never commit the real file.
# All values are read by server/config.js; existing environment variables win.

PORT=8788
HOST=127.0.0.1
DATA_DIR=./server/data

# Public origin used to build subscription links. Set this to the https domain
# in front of this service, otherwise links will use the internal Host header
# and clients cannot reach them.
PUBLIC_BASE_URL=https://api.example.com
TRUST_PROXY=true

# Static frontends allowed to call the API (comma separated, bare origins).
ALLOWED_ORIGINS=https://yggdrasil-afx.pages.dev,https://yakasuka.github.io

# No shared secret is required. The API is public: a subscription link carries
# its own random 256-bit key in the URL (/subscription/<id>/<key>.yaml), which
# is generated when the link is created. Anyone holding the link can read its
# config, so treat each link as a credential and keep it private.

# "bundled" uses shared/catalog.json, the built-in snapshot of the repository
# example template resources/template/ratatoskr-template.yaml. Point at a
# remote template only if it carries the x-configurator metadata block.
TEMPLATE_URL=bundled
TCP_PROBE_ENABLED=false
