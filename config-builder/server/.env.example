# Copy to server/.env. Never commit the real file.
# All values are read by server/config.js; existing environment variables win.

PORT=8788
HOST=127.0.0.1
DATA_DIR=./server/data

# Public origin used to build subscription / merge / sub links. Set this to
# the https domain in front of this service, otherwise links will use the
# internal Host header and clients cannot reach them.
PUBLIC_BASE_URL=https://api.example.com
TRUST_PROXY=true

# Static frontends allowed to call the API (comma separated, bare origins).
ALLOWED_ORIGINS=https://yggdrasil-afx.pages.dev,https://yakasuka.github.io

# /merge and /sub authentication. The token is appended by the caller and is
# never written into any static page or repository file.
TOKEN=replace-with-a-long-random-token
GH_TOKEN=replace-with-a-github-token-that-can-read-the-private-repo
PRIVATE_REPO=https://api.github.com/repos/yakasuka/yggdrasil-private/contents
PUBLIC_CONFIG_URL=https://raw.githubusercontent.com/yakasuka/yggdrasil/main/resources/template/ratatoskr-template.yaml

# "bundled" uses shared/catalog.json, or point at a remote template.
TEMPLATE_URL=bundled
TCP_PROBE_ENABLED=false
