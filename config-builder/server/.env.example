# Copy to server/.env. Never commit the real file.
# All values are read by server/config.js; existing environment variables win.

PORT=8788
HOST=127.0.0.1
DATA_DIR=./server/data

# Share codes live in DATA_DIR too. 0 means codes never expire; set a number of
# seconds to clean them up automatically. The AES key for sealed codes is
# generated once at DATA_DIR/.preset-key (mode 0600) - keep that file to read
# previously issued codes.
PRESET_TTL=0

# Public origin used to build subscription links. Set this to the https domain
# in front of this service, otherwise links will use the internal Host header
# and clients cannot reach them.
PUBLIC_BASE_URL=https://api.example.com
TRUST_PROXY=true

# Static frontends allowed to call the API (comma separated, bare origins).
ALLOWED_ORIGINS=https://yggdrasil-afx.pages.dev,https://yakasuka.github.io

# Owner-only web dashboard at /config-builder/dashboard and its management API
# (GET/DELETE /api/admin/configs) use the same HTTP Basic auth. Comma separated
# "user:password" pairs. Never exposed to the frontend or returned by
# /api/endpoints. Leave empty to disable the dashboard and management API.
ADMIN_USERS=admin:change-me

# Full public prefix shown for each config in the dashboard, including the
# mount path, e.g. https://yggdrasil-afx.pages.dev/yggdrasil/config-builder.
# Optional; when unset the dashboard links to this service's own origin.
PUBLIC_LINK_BASE=https://yggdrasil-afx.pages.dev/yggdrasil/config-builder

# The API is otherwise public: a subscription link carries its own random key
# in the URL, generated when the link is created. Anyone holding the link can
# read its config, so treat each link as a credential and keep it private.

# "bundled" uses shared/catalog.json, the built-in snapshot of the repository
# example template resources/template/ratatoskr-template.yaml. Point at a
# remote template only if it carries the x-configurator metadata block.
TEMPLATE_URL=bundled
# Node latency probing is on by default; only "false" turns it off.
TCP_PROBE_ENABLED=true

# Real url-test latency (recommended for hysteria2 / UDP nodes).
# Point this at a mihomo (Clash Meta) executable. When set, /api/latency
# measures latency by routing a request through each node to URL_TEST_URL,
# matching the client's url-test group. Leave empty to use plain TCP connect,
# which cannot measure UDP-only nodes and will show "未检测" for hysteria2.
# MIHOMO_BIN=/opt/yggdrasil-service/mihomo/mihomo
# URL_TEST_URL=https://www.gstatic.com/generate_204
# URL_TEST_TIMEOUT=10000
