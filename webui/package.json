{
  "name": "yggdrasil-subscription-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "build": "npm run catalog && node scripts/build-builder.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:whoami": "wrangler whoami"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.0.0"
  }
}
