# Docker build context is the repository root. Keep credentials, encrypted
# records and build leftovers out of the image: the runtime receives TOKEN /
# GH_TOKEN through environment variables or --env-file instead.
.git
.github
**/node_modules
**/.wrangler
**/worker/gateway/dist
**/.env
**/.env.*
!**/.env.example
config-builder/server/data
config-builder/test-results
docs
resources
assets
*.log
